{
  "name": "@nestbun/socket.io",
  "version": "0.4.0",
  "description": "NestJS Socket.IO gateways on Bun.serve, sharing the HTTP port of @nestbun/platform",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun test"
  },
  "keywords": [
    "nestjs",
    "bun",
    "socket.io",
    "websocket",
    "gateway",
    "adapter",
    "bun.serve"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mguay22/nestbun.git",
    "directory": "packages/socket.io"
  },
  "homepage": "https://mguay22.github.io/nestbun/",
  "bugs": "https://github.com/mguay22/nestbun/issues",
  "engines": {
    "bun": ">=1.4.0"
  },
  "peerDependencies": {
    "@nestbun/platform": "0.4.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-socket.io": "^12.0.0",
    "@nestjs/websockets": "^12.0.0",
    "rxjs": "^7.1.0",
    "socket.io": "^4.8.0"
  },
  "dependencies": {
    "@socket.io/bun-engine": "0.1.2"
  },
  "devDependencies": {
    "@nestbun/platform": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/testing": "12.3.2",
    "@nestjs/websockets": "12.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.3"
  }
}
